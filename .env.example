# Dedicated development PostgreSQL database. Never use a production URL for tests.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lingua?sslmode=require

# Local OAuth application URL. Use the exact same origin in the GitHub OAuth app.
# Use HTTPS for deployed environments.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
# Stable numeric GitHub account ID, not username or email.
GITHUB_OWNER_ID=REPLACE_WITH_NUMERIC_GITHUB_ID
